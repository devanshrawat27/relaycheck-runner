{
  "name": "@relaycheck/scenario-runner",
  "version": "0.1.0",
  "private": true,
  "description": "RelayCheck Scenario Runner - consumes run jobs from RabbitMQ, executes bounded scenarios against the configured local demo receiver, and reports evidence through private Control API endpoints.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "dlq": "node scripts/dlq.mjs",
    "test": "jest --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/amqplib": "^0.10.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}

