# RelayCheck Scenario Runner - placeholder values only.
# Copy to .env before overriding anything.
# Never commit a real .env file or real credentials.

# RabbitMQ run-job queue.
AMQP_URL=amqp://guest:guest@localhost:5672

# Control API base URL and the shared internal credential used to report
# lifecycle/evidence updates. The runner never connects to the platform DB.
CONTROL_API_URL=http://localhost:3200
INTERNAL_API_TOKEN=placeholder-internal-token

# Fixed demo receiver target. Must be local (localhost/127.0.0.1) — the
# runner refuses any other host. Never user-controllable at runtime.
DEMO_RECEIVER_URL=http://localhost:3100
